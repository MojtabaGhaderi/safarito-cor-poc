{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "diagnostics": false,
        "tsconfig": {
          "module": "ES2022",
          "moduleResolution": "node"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}